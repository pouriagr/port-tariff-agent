# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used by the TariffAgent ReAct loop. Switch to a Pro model if accuracy is insufficient.
GEMINI_MODEL_AGENT=gemini-3.8-flash

# Model used by the extractors that read the document: PageTranscriber, DocumentProfiler,
# and the ChargeSelector behind the get_charges tool.
GEMINI_MODEL_EXTRACT=gemini-3.8-flash

# Model used by the ChargeClassifier, which makes one small call per section. A lighter
# model keeps a full ingestion inside free-tier limits (see ADR-017).
GEMINI_MODEL_CLASSIFY=gemini-3.5-flash-lite

# Root folder for ingested documents (documents.json and one folder per document hash).
DATA_DIR=data

# Optional tuning. The defaults are what the code uses when these are unset.

# Pages transcribed in parallel during ingestion. Lower it if the free tier rate-limits.
INGEST_CONCURRENCY=4

# Retry policy for every model call: attempts, per-call timeout, and the base delay the
# exponential backoff grows from.
LLM_MAX_ATTEMPTS=6
LLM_TIMEOUT_S=600
LLM_BASE_DELAY_S=2

# Only sent to the API when set, because the two Gemini generations spell these knobs
# differently and sending the wrong one is a 400. Leave them empty unless you know which
# generation the models above belong to.
GEMINI_THINKING_LEVEL=
GEMINI_MEDIA_RESOLUTION=
